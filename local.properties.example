# Copy this file to local.properties for local personal builds.
# Obtain a client id from https://anilist.co/settings/developer.
anilistClientId=

# Optional: set these for signed release APK/AAB builds.
# You can also provide the equivalent environment variables:
# TANKOBUN_RELEASE_STORE_FILE, TANKOBUN_RELEASE_STORE_PASSWORD,
# TANKOBUN_RELEASE_KEY_ALIAS, and TANKOBUN_RELEASE_KEY_PASSWORD.
tankobunReleaseStoreFile=
tankobunReleaseStorePassword=
tankobunReleaseKeyAlias=
tankobunReleaseKeyPassword=

# Optional: app update manifest used by Settings > About.
# You can also provide TANKOBUN_UPDATE_MANIFEST_URL.
tankobunUpdateManifestUrl=https://johankrs.github.io/Tankobun/updates.json
